rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usernames/{usernameId} {
      // 회원가입 사전 체크(미인증 상태)를 위한 단일 문서 조회만 공개 허용.
      // list는 막아 닉네임 전수 스크래핑을 방지한다.
      allow get: if true;
      allow list: if false;

      // 문서가 아직 없을 때만 Firestore가 이 쓰기를 'create'로 분류한다. 이미 존재하면
      // 'update'로 취급되어 아래 update 규칙(false)에 막힌다 — 이 동작 자체가 동시 가입
      // 경쟁 상태를 막는 서버 측 원자성 보장이다.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid
                    && request.resource.data.keys().hasOnly(['uid', 'displayName', 'createdAt'])
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() > 0
                    && request.resource.data.displayName.size() <= 20
                    && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if false;
    }

    match /courses/{courseId} {
      // 코스는 로그인 없이도 홈 화면에서 볼 수 있어야 하는 공개 카탈로그.
      allow read: if true;

      // 업로더 본인(auth.uid)만 자기 이름으로 코스를 만들 수 있다. likeCount는 항상 0으로
      // 시작(좋아요 기능이 없어 클라이언트가 임의의 초기값을 넣을 이유가 없음), createdAt은
      // 서버 시각(serverTimestamp())과 정확히 같아야 한다 — usernames의 createdAt 검증과 동일한 이유.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uploaderId
                    && request.resource.data.keys().hasOnly([
                         'name', 'coordinates', 'category', 'difficulty', 'distanceKm',
                         'uploaderId', 'uploaderName', 'likeCount', 'createdAt'
                       ])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 40
                    && request.resource.data.coordinates is list
                    && request.resource.data.coordinates.size() > 0
                    && request.resource.data.category is string
                    && request.resource.data.difficulty is int
                    && request.resource.data.difficulty >= 1
                    && request.resource.data.difficulty <= 5
                    && request.resource.data.distanceKm is number
                    && request.resource.data.distanceKm > 0
                    && request.resource.data.uploaderName is string
                    && request.resource.data.likeCount == 0
                    && request.resource.data.createdAt == request.time;

      // 좋아요/수정/삭제 기능이 아직 없어 전부 차단 — 필요해지면 그때 별도 규칙 추가.
      allow update: if false;
      allow delete: if false;
    }

    match /runLogs/{logId} {
      // 러닝 기록은 본인 것만 조회 가능 (다른 유저의 러닝 기록은 비공개).
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.keys().hasOnly([
                         'userId', 'trajectory', 'startedAt', 'durationSec', 'paceSecPerKm',
                         'courseName', 'distanceKm', 'cadenceSpm', 'avgHeartRateBpm',
                         'elevationSeries', 'paceSeries', 'heartRateSeries', 'difficulty', 'isUploaded'
                       ])
                    && request.resource.data.trajectory is list
                    && request.resource.data.trajectory.size() > 0
                    && request.resource.data.courseName is string
                    && request.resource.data.distanceKm is number
                    && request.resource.data.difficulty is int
                    && request.resource.data.difficulty >= 1
                    && request.resource.data.difficulty <= 5
                    && request.resource.data.isUploaded is bool;

      // "나중에 업로드" 재시도 흐름(uploadRunLog) 전용 — 본인 문서에 한해 courseName/isUploaded
      // 두 필드만 바꾸는 것을 허용한다. 그 외 필드(trajectory, userId 등)는 수정 불가.
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.userId
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['courseName', 'isUploaded']);

      allow delete: if false;
    }

    // 명시적으로 연 usernames/courses/runLogs 외에는 모두 차단 (향후 컬렉션 추가 시 실수로 열리는 것 방지)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
