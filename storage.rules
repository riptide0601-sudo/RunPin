rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profilePhotos/{uid}.jpg {
      // 프로필 사진은 앱 어디서나 보여야 하는 공개 자산이라 읽기는 공개.
      allow read: if true;

      // 본인 uid 파일만, 5MB 이하 JPEG로만 쓸 수 있다. 파일명이 곧 uid라 다른 사람
      // 사진을 덮어쓸 수 없다(경로 자체가 권한 검사와 같은 역할).
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType == 'image/jpeg';
    }

    // 명시적으로 연 profilePhotos 외에는 모두 차단.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
